{
  "name": "arcade",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "A small house of focused games. Shared runtime, one game finished, nothing collected.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",

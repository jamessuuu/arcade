    "verify:play": "node tests/play-harbor-watch.mjs",
    "verify:gpu": "node tests/play-harbor-watch.mjs --gpu",
    "verify:headed": "node tests/play-harbor-watch.mjs --headed",
    "verify:network": "node tests/network-capture.mjs",
    "verify:claims": "node tests/claims-check.mjs",
    "verify:patterns": "node tests/dark-pattern-check.mjs",
    "verify:a11y": "node tests/a11y-check.mjs",
    "verify:budget": "node tests/bundle-budget.mjs",
    "verify:bytes": "node tests/control-byte-sweep.mjs",
    "verify:motion": "node tests/portal-cost.mjs",
    "shots:portal": "node tests/shot-pair.mjs after",
    "shots": "node tests/screenshots.mjs"
  },
  "dependencies": {
    "pixi.js": "^8.6.6"
  },
  "devDependencies": {
    "vite": "^6.0.7"
  }
